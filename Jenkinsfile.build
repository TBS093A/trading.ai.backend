/*
 * Dedicated build+push+deploy pipeline for trading-ai-backend - separate from the existing
 * `Jenkinsfile` (which still handles the legacy deploy.sh path, config-env.yml generation, and
 * everything else). Build, tag with commit SHA (immutable, not :latest), push to the self-hosted
 * registry, then bump that tag into all three cloud.config workloads and push - ArgoCD
 * (selfHeal: true) rolls it out on its own.
 *
 * Trigger: Gitea webhook on push + pull_request (see repo hook settings). Gitea's API can't filter
 * pull_request sub-events at the webhook level - it's all-or-nothing (opened, comments, labels,
 * reviews all fire the same webhook). Filtered here instead via regexpFilterExpression: only
 * "opened"/"synchronize"/"reopened" pull_request actions or plain pushes (no "action" field at
 * all, hence the empty alternative in the regex) actually start a build.
 *
 * Test & Coverage stage runs in catchError(stageResult: 'UNSTABLE') like the security scans -
 * tests/tests/technical_analysis_tests/technical_analysis_integration.py needs a real
 * TEST_DATABASE_URL and exchange credentials that aren't wired into Jenkins yet (deliberately -
 * a misconfigured TEST_DATABASE_URL pointing at production would be catastrophic, since the
 * db-integration tests call drop_all_tables()). Without real credentials configured this stage
 * will fail cleanly (connection error) rather than deploy or touch anything - safe by
 * construction, not just by convention. Wire real test-DB credentials in before relying on this.
 *
 * PR comment stage posts a results summary back to the PR via Gitea's issue-comment API when this
 * build was triggered by a pull_request event (pr_number extracted from the webhook payload) -
 * skipped entirely for plain push builds.
 *
 * Credentials needed in Jenkins (already exist, shared with other pipelines):
 *   registry-credentials   (Username with password) - registry.00x097.com login
 *   git-gitea-tbs093a      (Username with password) - push access to cloud.config + PR comments
 */
pipeline {
    agent {
        node {
            label 'docker-builder && linux'
        }
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'action', value: '$.action'],
                [key: 'pr_number', value: '$.number']
            ],
            token: 'trading-ai-backend-build',
            regexpFilterText: '$action',
            regexpFilterExpression: '^(opened|synchronize|reopened|)$'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                // Report files from a previous build in this reused workspace must not leak into
                // this run's PR comment (found live: a skipped-on-PR DAST stage still showed a
                // stale "6 warnings" from an earlier build's leftover zap-report.json).
                sh '''
                    rm -f semgrep-report.json trivy-fs-report.json trivy-image-report.json coverage.xml pr-comment-body.json
                    rm -rf zap-out coverage
                '''
            }
        }

        stage('Test & Coverage') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        docker run --rm -v "$WORKSPACE:/src" -w /src python:3.13.1-slim \
                            bash -c "pip install --quiet tox && tox -e technical-analysis-tests"
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'coverage.xml', allowEmptyArchive: true
                }
            }
        }

        stage('SAST - Semgrep') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        docker run --rm -v "$WORKSPACE:/src" semgrep/semgrep \
                            semgrep scan --config=auto --json --output=/src/semgrep-report.json /src
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'semgrep-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('SCA - dependencies (Trivy fs)') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        docker run --rm -v "$WORKSPACE:/src" aquasec/trivy fs \
                            --format json --output /src/trivy-fs-report.json \
                            --severity HIGH,CRITICAL /src
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-fs-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Build & push image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USER',
                        passwordVariable: 'REGISTRY_PASS'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        docker build -t registry.00x097.com/trading-ai-backend:${GIT_COMMIT} .
                        echo "$REGISTRY_PASS" | docker login registry.00x097.com -u "$REGISTRY_USER" --password-stdin
                        docker push registry.00x097.com/trading-ai-backend:${GIT_COMMIT}
                        docker logout registry.00x097.com
                    '''
                }
            }
        }

        stage('SCA - image (Trivy image)') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'registry-credentials',
                            usernameVariable: 'REGISTRY_USER',
                            passwordVariable: 'REGISTRY_PASS'
                        )
                    ]) {
                        sh '''
                            set -euo pipefail
                            docker run --rm \
                                --env TRIVY_USERNAME="$REGISTRY_USER" \
                                --env TRIVY_PASSWORD="$REGISTRY_PASS" \
                                -v "$WORKSPACE:/out" \
                                aquasec/trivy image \
                                --format json --output /out/trivy-image-report.json \
                                --severity HIGH,CRITICAL \
                                registry.00x097.com/trading-ai-backend:${GIT_COMMIT}
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-image-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Bump cloud.config manifests') {
            when {
                expression { return !env.pr_number?.trim() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'git-gitea-tbs093a',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        rm -rf .cloud-config-bump
                        git clone "https://${GIT_USERNAME}:${GIT_TOKEN}@git.00x097.com/tbs093a/cloud.config.git" .cloud-config-bump
                        cd .cloud-config-bump

                        for f in kubernetes/apps/trading-ai-backend/deployment-rest-api.yml \
                                 kubernetes/apps/trading-ai-backend/deployment-sync.yml \
                                 kubernetes/apps/trading-ai-backend/daemonset-celery-workers.yml; do
                            yq eval -i '
                              (.. | select(tag == "!!str" and test("registry.development.svc.cluster.local:5000/trading-ai-backend:")))
                              |= sub("registry.development.svc.cluster.local:5000/trading-ai-backend:.*",
                                     "registry.development.svc.cluster.local:5000/trading-ai-backend:'"${GIT_COMMIT}"'")
                            ' "$f"
                        done

                        git config user.email "jenkins@00x097.com"
                        git config user.name "Jenkins (trading-ai-backend)"
                        if git diff --quiet kubernetes/apps/trading-ai-backend/; then
                            echo "image tag unchanged, nothing to commit"
                        else
                            git commit -am "chore(trading-ai-backend): deploy trading-ai-backend@${GIT_COMMIT}"
                            git push origin master
                        fi
                    '''
                }
                sh 'rm -rf .cloud-config-bump'
            }
        }

        stage('DAST - OWASP ZAP baseline') {
            when {
                expression { return !env.pr_number?.trim() }
            }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        mkdir -p zap-out
                        chmod 777 zap-out
                        # Baseline = passive spider + passive scan only, no active attack payloads -
                        # safe to run against the live production API. Do NOT swap this for
                        # zap-full-scan.py against api.00x097.com - that actively attacks the target,
                        # only ever run that against a non-production/staging environment.
                        docker run --rm -v "$WORKSPACE/zap-out:/zap/wrk:rw" zaproxy/zap-stable \
                            zap-baseline.py -t https://api.00x097.com \
                            -r zap-report.html -J zap-report.json || true
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap-out/**', allowEmptyArchive: true
                }
            }
        }

        stage('PR comment') {
            when {
                expression { return env.pr_number?.trim() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'git-gitea-tbs093a',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        python3 build-pr-comment.py > pr-comment-body.json
                        curl -s -X POST \
                            -H "Authorization: token ${GIT_TOKEN}" \
                            -H "Content-Type: application/json" \
                            -d @pr-comment-body.json \
                            "https://git.00x097.com/api/v1/repos/tbs093a/trading.ai.backend/issues/${pr_number}/comments"
                    '''
                }
            }
        }
    }
}
