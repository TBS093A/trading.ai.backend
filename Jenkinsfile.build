/*
 * Dedicated build+push+deploy pipeline for trading-ai-backend - separate from the existing
 * `Jenkinsfile` (which still handles the legacy deploy.sh path, config-env.yml generation, and
 * everything else). Three levels, each one a hard gate - a failing stage fails the build and
 * nothing after it runs:
 *
 *   CODE -> PRE-MERGE GATE -> MERGE -> POST-MERGE GATE -> RELEASE GATE -> PRODUCTION
 *
 *   PRE-MERGE  (every PR build and every master build)
 *     secret scan -> lint -> unit tests -> coverage threshold -> SAST -> SCA -> image build -> image scan
 *     CRITICAL vulnerability (with a fix available) -> FAIL, always
 *     HIGH vulnerability                            -> FAIL when FAIL_ON_HIGH
 *     Semgrep ERROR finding                         -> FAIL
 *     line coverage < MIN_COVERAGE                  -> FAIL
 *     Verdicts go to gate-results.json (ci-gate.py) -> PR comment + Gitea commit status
 *     "jenkins/pre-merge". Make that status required in Gitea branch protection for master,
 *     otherwise a red build is only advisory and not a merge gate.
 *
 *   POST-MERGE (master only - never on PR builds)
 *     push the exact image that passed the scan (immutable commit SHA tag) -> SBOM (CycloneDX)
 *     -> cosign signature (SIGN_IMAGE)
 *
 *   RELEASE
 *     optional manual approval (REQUIRE_RELEASE_APPROVAL) -> bump cloud.config (ArgoCD
 *     selfHeal rolls it out) -> wait for rollout + smoke test /live /ready -> automatic
 *     rollback (git revert of the bump commit) when that fails -> DAST baseline.
 *     There is no staging environment yet, so "deploy staging -> integration tests" is not part
 *     of this pipeline - integration tests (tox -e technical-analysis-tests) need a dedicated
 *     test database; they call drop_all_tables() and must never point at production.
 *
 * Same model as cloud.config's terraform pipelines (jenkins/scripts/maintenance/terraform-ci/):
 *   - Trust boundary: ci-gate.py, build-pr-comment.py, start-pr-comment.py and gitea.py are copied
 *     out of the job's own master checkout BEFORE the PR head replaces the workspace, so a PR
 *     can change the code being checked but not the checks or their verdicts.
 *   - PR builds check out the exact head SHA from the webhook payload and only gate open PRs
 *     against master; disableConcurrentBuilds() + "already passed" short-circuit absorbs the
 *     opened+synchronized pair Gitea sends for a new PR.
 *   - Post-merge delivery refuses unless the master commit is the merge of a PR whose head has
 *     jenkins/pre-merge = success (defence in depth on top of branch protection).
 *   - PR comments as git-gitea-jenkins-bot via gitea.py: "CI running" right away, edited into the
 *     results table at the end; after the merge the same on the merged PR ("Delivery running" ->
 *     gate + push/SBOM/sign/deploy/rollout/DAST table, with any rollback called out).
 *   - Webhooks like terraform's: one Gitea hook with only pull_request events, one with only push.
 *
 * Trigger: Gitea webhooks on push + pull_request. Gitea's API can't filter pull_request sub-events
 * at the webhook level, so filtered here via regexpFilterExpression: only
 * "opened"/"synchronized"/"reopened" pull_request actions or pushes to refs/heads/master (no
 * "action" field, hence defaultValue '' on the variables) start a build; tag pushes and pushes to
 * other branches are dropped. PR builds check out the
 * PR head (refs/pull/<n>/head), not master - otherwise the gate would be testing the wrong code.
 *
 * Credentials needed in Jenkins:
 *   trading-ai-backend-build-webhook-token (Secret text) - Generic Webhook Trigger token; the Gitea
 *                          webhook URL must use the same value (.../generic-webhook-trigger/invoke?token=...)
 *   registry-credentials   (Username with password) - registry.00x097.com login
 *   kubeconfig-trading-ai-deployer (Secret file) - kubeconfig of the least-privilege SA
 *                          development/jenkins-trading-ai-deployer (cloud.config ci-rbac/), used by the
 *                          RELEASE rollout/egress checks instead of the agent's cluster-admin kubeconfig
 *   git-gitea-tbs093a      (Username with password) - checkout of PR heads
 *   git-gitea-jenkins-bot  (Username with password) - PR comments, commit statuses and the
 *                          cloud.config image-tag bump / rollback commits (needs write
 *                          access to the repo for statuses)
 *   cosign-private-key     (Secret file) + cosign-password (Secret text) - SIGN_IMAGE (default on);
 *                          the matching public key is cosign.pub in the repo root
 */

import groovy.transform.Field

@Field def IMAGE = 'registry.00x097.com/trading-ai-backend'
@Field def CLUSTER_IMAGE = 'registry.development.svc.cluster.local:5000/trading-ai-backend'

@Field def GITEA_API = 'https://git.00x097.com/api/v1'
@Field def GITEA_REPO = 'tbs093a/trading.ai.backend'
@Field def GITEA_REMOTE = 'http://gitea.development.svc.cluster.local/tbs093a/trading.ai.backend.git'
@Field def DEFAULT_BRANCH = 'master'
@Field def PRE_MERGE_CONTEXT = 'jenkins/pre-merge'
@Field def RELEVANT_ACTIONS = ['opened', 'reopened', 'synchronized']
@Field def CI_SCRIPTS = ['ci-gate.py', 'build-pr-comment.py', 'start-pr-comment.py', 'gitea.py']

// Trusted copies of the CI scripts, taken from master before a PR head is checked out.
def ciDir() {
    return "${env.WORKSPACE}@tmp/ci"
}

def isPullRequest() {
    return env.PR_NUMBER?.trim() as boolean
}

// False for a webhook delivery that turned out to be nothing to build (closed PR, other base
// branch, head already gated) - every stage and post action checks it.
def active() {
    return env.SKIP_BUILD != 'true'
}

def skipBuild(String why) {
    echo why
    env.SKIP_BUILD = 'true'
    currentBuild.result = 'NOT_BUILT'
}

// Webhook pushes only reach this job for master (trigger filter); manual runs have no ref.
def isPostMerge() {
    return active() && !isPullRequest() && (!env.GITEA_REF?.trim() || env.GITEA_REF == "refs/heads/${DEFAULT_BRANCH}")
}

def gitea(String args) {
    withCredentials([usernamePassword(credentialsId: 'git-gitea-jenkins-bot',
                                      usernameVariable: 'GITEA_USER', passwordVariable: 'GITEA_TOKEN')]) {
        withEnv(["GITEA_API=${GITEA_API}", "GITEA_REPO=${GITEA_REPO}"]) {
            return sh(script: "python3 '${ciDir()}/gitea.py' ${args}", returnStdout: true).trim()
        }
    }
}

// cloud.config image-tag bumps (and their rollback reverts) are committed and pushed as
// git-gitea-jenkins-bot - env vars, because the agent's own git identity ("jenkins") overrides
// a repo-level git config.
def gitBotEnv() {
    return ['GIT_AUTHOR_NAME=jenkins-bot', 'GIT_AUTHOR_EMAIL=jenkins-bot@00x097.com',
            'GIT_COMMITTER_NAME=jenkins-bot', 'GIT_COMMITTER_EMAIL=jenkins-bot@00x097.com']
}

def jsonField(String json, String field) {
    return sh(script: "printf '%s' '${json}' | python3 -c 'import json, sys; print(json.load(sys.stdin)[\"${field}\"])'",
              returnStdout: true).trim()
}

// A status that can't be posted is reported in the log, never fails the build.
def setStatus(String state, String description) {
    if (!env.BUILD_SHA) {
        return
    }
    def context = isPullRequest() ? PRE_MERGE_CONTEXT : 'jenkins/post-merge'
    try {
        gitea("status ${env.BUILD_SHA} ${state} ${context} '${description}'")
    } catch (err) {
        echo "Could not set commit status ${context}=${state}: ${err}"
    }
}

def postStartComment(String pr, String title) {
    try {
        withEnv(["COMMIT_SHA=${env.BUILD_SHA}", "CI_TITLE=${title}"]) {
            sh "python3 '${ciDir()}/start-pr-comment.py' > pr-comment-body.json"
        }
        env.PR_COMMENT_ID = gitea("comment-post ${pr} pr-comment-body.json")
    } catch (err) {
        echo "Could not post the PR comment: ${err}"
    }
}

def updateResultsComment() {
    if (!env.PR_COMMENT_ID) {
        return
    }
    try {
        withEnv(["COMMIT_SHA=${env.BUILD_SHA}", "CI_MODE=${isPullRequest() ? 'gate' : 'delivery'}",
                 "BUILD_RESULT=${currentBuild.currentResult}"]) {
            sh "python3 '${ciDir()}/build-pr-comment.py' > pr-comment-body.json"
        }
        gitea("comment-patch ${env.PR_COMMENT_ID} pr-comment-body.json")
    } catch (err) {
        echo "Could not update the PR comment: ${err}"
    }
}

pipeline {
    agent {
        node {
            label 'docker-builder && linux'
        }
    }

    options {
        // One build at a time: deploys must not interleave, and the second of Gitea's
        // opened+synchronized pair then sees the first one's verdict and stops.
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    parameters {
        booleanParam(
            name: 'FAIL_ON_HIGH',
            defaultValue: false,
            description: 'Fail PRE-MERGE on HIGH vulnerabilities with a fix available (CRITICAL always fails). Off until urllib3 1.26 / msgpack 1.0.3 (pinned by exchange SDKs) and curl_cffi<0.14 are upgraded.'
        )
        string(
            name: 'MIN_COVERAGE',
            defaultValue: '25',
            description: 'Minimum line coverage (%) of src/ from tests/unit - raise it as unit tests are added, never lower it.'
        )
        booleanParam(
            name: 'SIGN_IMAGE',
            defaultValue: true,
            description: 'Sign the pushed image with cosign and verify the signature against cosign.pub in this repo (cosign-private-key + cosign-password credentials).'
        )
        booleanParam(
            name: 'REQUIRE_RELEASE_APPROVAL',
            defaultValue: false,
            description: 'Wait for manual approval before deploying to production.'
        )
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                // defaultValue '' matters: a push payload has no "action" field, and without a default
                // the variable stays unresolved, regexpFilterText is the literal "$PR_ACTION" and the
                // filter silently drops every push.
                [key: 'PR_ACTION', value: '$.action', defaultValue: ''],
                [key: 'PR_NUMBER', value: '$.number', defaultValue: ''],
                [key: 'PR_HEAD_SHA', value: '$.pull_request.head.sha', defaultValue: ''],
                [key: 'PR_BASE_REF', value: '$.pull_request.base.ref', defaultValue: ''],
                [key: 'PR_STATE', value: '$.pull_request.state', defaultValue: ''],
                [key: 'GITEA_REF', value: '$.ref', defaultValue: ''],
                [key: 'GITEA_AFTER', value: '$.after', defaultValue: '']
            ],
            tokenCredentialId: 'trading-ai-backend-build-webhook-token',
            // Builds only PR opened/synchronized/reopened and pushes to master. Tag pushes and pushes to
            // other branches used to start a full build each (a history rewrite pushing master + 2
            // tags queued three) - feature branches are covered by their PR build anyway.
            causeString: 'Gitea $PR_ACTION$GITEA_REF #$PR_NUMBER$GITEA_AFTER',
            regexpFilterText: '$PR_ACTION|$GITEA_REF',
            regexpFilterExpression: '^((opened|synchronized|reopened)\\|.*|\\|refs/heads/master)$'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                // The job's own SCM checkout is master: take the trusted CI scripts from it before a
                // PR head replaces the workspace.
                checkout scm
                script {
                    env.CI_DIR = ciDir()
                    sh "rm -rf '${ciDir()}' && mkdir -p '${ciDir()}' && cp ${CI_SCRIPTS.join(' ')} '${ciDir()}/'"
                    if (isPullRequest()) {
                        if (!(env.PR_ACTION in RELEVANT_ACTIONS) || !env.PR_HEAD_SHA || env.PR_STATE != 'open' ||
                            env.PR_BASE_REF != DEFAULT_BRANCH) {
                            skipBuild("Not an open PR against ${DEFAULT_BRANCH} (action=${env.PR_ACTION}, state=${env.PR_STATE}, base=${env.PR_BASE_REF}) - nothing to gate.")
                            return
                        }
                        // Only a passed gate short-circuits: reopening a PR re-runs a failed one.
                        if (gitea("context-state ${env.PR_HEAD_SHA} ${PRE_MERGE_CONTEXT}") == 'success') {
                            skipBuild("${env.PR_HEAD_SHA} already passed ${PRE_MERGE_CONTEXT} - nothing to do.")
                            return
                        }
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: env.PR_HEAD_SHA]],
                            userRemoteConfigs: [[
                                url: GITEA_REMOTE,
                                credentialsId: 'git-gitea-tbs093a',
                                refspec: "+refs/pull/${env.PR_NUMBER}/head:refs/remotes/origin/pr/${env.PR_NUMBER}"
                            ]]
                        ])
                    }
                    env.BUILD_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    if (isPullRequest() && env.BUILD_SHA != env.PR_HEAD_SHA) {
                        error "Checked out ${env.BUILD_SHA}, expected PR head ${env.PR_HEAD_SHA}"
                    }
                    env.FAIL_SEVERITIES = params.FAIL_ON_HIGH ? 'CRITICAL,HIGH' : 'CRITICAL'
                    env.MIN_COVERAGE = params.MIN_COVERAGE ?: '25'
                    currentBuild.description = "${isPullRequest() ? "PR #${env.PR_NUMBER}" : DEFAULT_BRANCH} @ ${env.BUILD_SHA.take(8)}"
                }
                // Report files from a previous build in this reused workspace must not leak into
                // this run's gates or PR comment.
                sh '''
                    rm -f gate-results.json semgrep-report.json trivy-fs-report.json trivy-image-report.json \
                          gitleaks-report.json coverage.xml sbom.cdx.json image.tar pr-comment-body.json \
                          cloud-config-bump-sha.txt
                    rm -rf zap-out coverage sca-deps .gitleaks-src
                '''
                script {
                    if (active() && isPullRequest()) {
                        setStatus('pending', 'PRE-MERGE gate running')
                        postStartComment(env.PR_NUMBER, 'CI running')
                    }
                }
            }
        }

        stage('POST-MERGE: Verify origin (merged PR with passing gate)') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                script {
                    // Same check as terraform.post-merge.apply, on top of branch protection: deliver
                    // only a master commit that is the merge of a PR whose head passed the gate.
                    def pr = null
                    try {
                        pr = gitea("pr-for-merge ${env.BUILD_SHA}")
                    } catch (err) {
                        error "${env.BUILD_SHA} is not the merge commit of a PR - refusing to deliver"
                    }
                    env.MERGED_PR = jsonField(pr, 'number')
                    env.MERGED_PR_HEAD = jsonField(pr, 'head_sha')
                    def gate = gitea("context-state ${env.MERGED_PR_HEAD} ${PRE_MERGE_CONTEXT}")
                    if (gate != 'success') {
                        error "PR #${env.MERGED_PR} head ${env.MERGED_PR_HEAD.take(8)} has ${PRE_MERGE_CONTEXT}=${gate} - refusing to deliver"
                    }
                    currentBuild.description = "${DEFAULT_BRANCH} @ ${env.BUILD_SHA.take(8)} (PR #${env.MERGED_PR})"
                    setStatus('pending', 'Delivery running')
                    postStartComment(env.MERGED_PR, 'Delivery running')
                    if (!params.SIGN_IMAGE) {
                        sh 'python3 "$CI_DIR/ci-gate.py" result sign 0 "skipped (SIGN_IMAGE off)"'
                    }
                }
            }
        }

        // ============================== PRE-MERGE GATE ==============================

        stage('PRE-MERGE: Secret scan (gitleaks)') {
            when {
                expression { return active() }
            }
            steps {
                // Scans exactly the tracked files of the commit under test (git archive), not the
                // workspace - .tox/ and other build leftovers would only add noise.
                sh '''
                    set -euo pipefail
                    mkdir .gitleaks-src
                    git archive HEAD | tar -x -C .gitleaks-src
                    rc=0
                    docker run --rm -v "$WORKSPACE:/src" zricethezav/gitleaks:v8.30.1 \
                        dir /src/.gitleaks-src --redact --no-banner \
                        --report-format json --report-path /src/gitleaks-report.json || rc=$?
                    rm -rf .gitleaks-src
                    leaks=$(python3 -c "import json; print(len(json.load(open('gitleaks-report.json'))))" 2>/dev/null || echo "?")
                    detail="$leaks leaks in tracked files"
                    # Telethon *.session files are binary SQLite (live Telegram auth_key) - gitleaks
                    # skips binary files, so they need an explicit check.
                    sessions=$(git ls-files -- '*.session' | tr '\n' ' ')
                    if [ -n "$sessions" ]; then
                        echo "Tracked Telethon session files: $sessions"
                        rc=1
                        detail="$detail; tracked *.session files: $sessions"
                    fi
                    python3 "$CI_DIR/ci-gate.py" result secrets "$rc" "$detail"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('PRE-MERGE: Lint (ruff)') {
            when {
                expression { return active() }
            }
            steps {
                // Fatal-error rule set (syntax errors, undefined names, invalid comparisons) - the
                // class of bug that crashes at runtime. Widen --select as the codebase gets cleaned up.
                sh '''
                    set -euo pipefail
                    rc=0
                    docker run --rm -v "$WORKSPACE:/src" -w /src python:3.13-slim bash -c \
                        "pip install --quiet --root-user-action=ignore ruff==0.16.10 && ruff check --no-cache --output-format concise --select E9,F63,F7,F82 ." \
                        || rc=$?
                    python3 "$CI_DIR/ci-gate.py" result lint "$rc" "ruff E9,F63,F7,F82"
                '''
            }
        }

        stage('PRE-MERGE: Unit tests & coverage') {
            when {
                expression { return active() }
            }
            steps {
                // tests/unit only - no DB, network or credentials, so this is safe to be blocking.
                // pip freeze of the test venv gives Trivy a resolved dependency list: tox.ini deps
                // are not a format Trivy understands, so without it SCA-fs would scan nothing.
                // Trivy only recognises the exact file name requirements.txt, hence the subdirectory.
                sh '''
                    set -euo pipefail
                    rc=0
                    docker run --rm -v "$WORKSPACE:/src" -w /src python:3.13-slim bash -c \
                        "pip install --quiet --root-user-action=ignore tox && tox -e unit-tests && mkdir -p sca-deps && .tox/unit-tests/bin/python -m pip freeze > sca-deps/requirements.txt" \
                        || rc=$?
                    python3 "$CI_DIR/ci-gate.py" result tests "$rc" "tox -e unit-tests"
                    python3 "$CI_DIR/ci-gate.py" coverage coverage.xml --min "$MIN_COVERAGE"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'coverage.xml, sca-deps/requirements.txt', allowEmptyArchive: true
                }
            }
        }

        stage('PRE-MERGE: SAST (Semgrep)') {
            when {
                expression { return active() }
            }
            steps {
                sh '''
                    set -euo pipefail
                    docker run --rm -v "$WORKSPACE:/src" semgrep/semgrep \
                        semgrep scan --config=auto --json --output=/src/semgrep-report.json /src
                    python3 "$CI_DIR/ci-gate.py" semgrep semgrep-report.json --fail-on ERROR
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'semgrep-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('PRE-MERGE: SCA dependencies (Trivy fs)') {
            when {
                expression { return active() }
            }
            steps {
                sh '''
                    set -euo pipefail
                    docker run --rm -v "$WORKSPACE:/src" aquasec/trivy:0.75.0 fs \
                        --skip-dirs /src/.tox \
                        --format json --output /src/trivy-fs-report.json \
                        --severity HIGH,CRITICAL /src
                    python3 "$CI_DIR/ci-gate.py" trivy trivy-fs-report.json --name sca-fs \
                        --fail-on "$FAIL_SEVERITIES" --ignore-unfixed
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-fs-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('PRE-MERGE: Image build & scan (Trivy image)') {
            when {
                expression { return active() }
            }
            steps {
                // Scanned from a local tarball before anything is pushed - an image that fails
                // this gate never reaches the registry.
                sh """
                    set -euo pipefail
                    docker build -t ${IMAGE}:\${BUILD_SHA} .
                    docker save -o image.tar ${IMAGE}:\${BUILD_SHA}
                    docker run --rm -v "\$WORKSPACE:/out" aquasec/trivy:0.75.0 image \
                        --input /out/image.tar \
                        --format json --output /out/trivy-image-report.json \
                        --severity HIGH,CRITICAL
                    rm -f image.tar
                    python3 "\$CI_DIR/ci-gate.py" trivy trivy-image-report.json --name sca-image \
                        --fail-on "\$FAIL_SEVERITIES" --ignore-unfixed
                """
            }
            post {
                always {
                    sh 'rm -f image.tar'
                    archiveArtifacts artifacts: 'trivy-image-report.json', allowEmptyArchive: true
                }
            }
        }

        // ============================== POST-MERGE GATE ==============================

        stage('POST-MERGE: Push immutable image') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USER',
                        passwordVariable: 'REGISTRY_PASS'
                    )
                ]) {
                    sh """
                        set -euo pipefail
                        echo "\$REGISTRY_PASS" | docker login registry.00x097.com -u "\$REGISTRY_USER" --password-stdin
                        docker push ${IMAGE}:\${BUILD_SHA}
                        docker logout registry.00x097.com
                    """
                }
                script {
                    env.IMAGE_DIGEST = sh(
                        script: "docker inspect --format='{{index .RepoDigests 0}}' ${IMAGE}:${env.BUILD_SHA}",
                        returnStdout: true
                    ).trim()
                    echo "Pushed ${env.IMAGE_DIGEST}"
                    sh "python3 \"\$CI_DIR/ci-gate.py\" result push 0 '${env.IMAGE_DIGEST.replaceAll('.*@', '')}'"
                }
            }
        }

        stage('POST-MERGE: SBOM (CycloneDX)') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USER',
                        passwordVariable: 'REGISTRY_PASS'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        docker run --rm \
                            --env TRIVY_USERNAME="$REGISTRY_USER" \
                            --env TRIVY_PASSWORD="$REGISTRY_PASS" \
                            -v "$WORKSPACE:/out" \
                            aquasec/trivy:0.75.0 image \
                            --format cyclonedx --output /out/sbom.cdx.json \
                            "$IMAGE_DIGEST"
                        python3 "$CI_DIR/ci-gate.py" result sbom 0 "CycloneDX, archived as sbom.cdx.json"
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'sbom.cdx.json', allowEmptyArchive: true
                }
            }
        }

        stage('POST-MERGE: Sign image (cosign)') {
            when {
                expression { return isPostMerge() && params.SIGN_IMAGE }
            }
            steps {
                withCredentials([
                    file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY_FILE'),
                    string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD'),
                    usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USER',
                        passwordVariable: 'REGISTRY_PASS'
                    )
                ]) {
                    // Signed by digest, not tag. --tlog-upload=false: private registry, nothing is
                    // published to the public Rekor transparency log (hence --insecure-ignore-tlog on
                    // verify). Verified right away against the committed cosign.pub, so a signature
                    // that anyone can check with that file is part of the gate, not just a side effect.
                    // Run as the agent user: the credential file is 0600 and owned by it.
                    sh '''
                        set -euo pipefail
                        COSIGN="docker run --rm -u $(id -u):$(id -g) -e HOME=/tmp --env COSIGN_PASSWORD \
                            -v $COSIGN_KEY_FILE:/cosign.key:ro -v $WORKSPACE/cosign.pub:/cosign.pub:ro \
                            gcr.io/projectsigstore/cosign:v2.4.1"
                        $COSIGN sign --yes --key /cosign.key --tlog-upload=false \
                            --registry-username "$REGISTRY_USER" --registry-password "$REGISTRY_PASS" \
                            "$IMAGE_DIGEST"
                        $COSIGN verify --key /cosign.pub --insecure-ignore-tlog=true \
                            --registry-username "$REGISTRY_USER" --registry-password "$REGISTRY_PASS" \
                            "$IMAGE_DIGEST" > /dev/null
                        echo "cosign: signed and verified $IMAGE_DIGEST"
                        python3 "$CI_DIR/ci-gate.py" result sign 0 "signed + verified against cosign.pub"
                    '''
                }
            }
        }

        // ============================== RELEASE GATE ==============================

        stage('RELEASE: Approval') {
            when {
                expression { return isPostMerge() && params.REQUIRE_RELEASE_APPROVAL }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Deploy trading-ai-backend@${env.BUILD_SHA.take(8)} to production?", ok: 'Deploy'
                }
            }
        }

        stage('RELEASE: Deploy (bump cloud.config)') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'git-gitea-jenkins-bot',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    withEnv(gitBotEnv()) {
                        sh """
                            set -euo pipefail
                            rm -rf .cloud-config-bump
                            git clone "https://\${GIT_USERNAME}:\${GIT_TOKEN}@git.00x097.com/tbs093a/cloud.config.git" .cloud-config-bump
                            cd .cloud-config-bump

                            for f in kubernetes/apps/trading-ai-backend/deployment-rest-api.yml \\
                                     kubernetes/apps/trading-ai-backend/deployment-sync.yml \\
                                     kubernetes/apps/trading-ai-backend/daemonset-celery-workers.yml; do
                                yq eval -i '
                                  (.. | select(tag == "!!str" and test("${CLUSTER_IMAGE}:")))
                                  |= sub("${CLUSTER_IMAGE}:.*", "${CLUSTER_IMAGE}:'"\${BUILD_SHA}"'")
                                ' "\$f"
                            done

                            # GIT_AUTHOR_*/GIT_COMMITTER_* (gitBotEnv) win over git config and over the agent's own
                            # "jenkins" identity - the bump shows up in cloud.config as jenkins-bot.
                            if git diff --quiet kubernetes/apps/trading-ai-backend/; then
                                echo "image tag unchanged, nothing to commit"
                            else
                                git commit -am "chore(trading-ai-backend): deploy trading-ai-backend@\${BUILD_SHA}"
                                git push origin master
                                git rev-parse HEAD > ../cloud-config-bump-sha.txt
                            fi
                        """
                    }
                }
                sh 'rm -rf .cloud-config-bump'
                sh '''
                    if [ -s cloud-config-bump-sha.txt ]; then detail="cloud.config $(cut -c1-8 cloud-config-bump-sha.txt)"; else detail="image tag unchanged"; fi
                    python3 "$CI_DIR/ci-gate.py" result deploy 0 "$detail"
                '''
            }
        }

        stage('RELEASE: Verify rollout (smoke + health, auto-rollback)') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                script {
                    try {
                        // Least-privilege SA (cloud.config ci-rbac/jenkins-trading-ai-deployer.yml), not the
                        // agent's cluster-admin kubeconfig: read rollout status + exec in backend-apps only.
                        withCredentials([file(credentialsId: 'kubeconfig-trading-ai-deployer', variable: 'KUBECONFIG')]) {
                            sh """
                                set -euo pipefail
                                NS=backend-apps
                                WANT="${CLUSTER_IMAGE}:\${BUILD_SHA}"

                                # ArgoCD applies the cloud.config commit asynchronously - wait until the
                                # Deployment spec actually carries the new tag before checking rollout.
                                current=""
                                for i in \$(seq 1 60); do
                                    current=\$(kubectl -n "\$NS" get deployment trading-ai-backend-rest-api-controller \\
                                        -o jsonpath='{.spec.template.spec.containers[?(@.name=="trading-ai-backend-rest-api-controller")].image}')
                                    [ "\$current" = "\$WANT" ] && break
                                    sleep 10
                                done
                                if [ "\$current" != "\$WANT" ]; then
                                    echo "ArgoCD did not apply \$WANT within 10 minutes (current: \$current)"
                                    exit 1
                                fi

                                kubectl -n "\$NS" rollout status deployment/trading-ai-backend-rest-api-controller --timeout=10m
                                kubectl -n "\$NS" rollout status deployment/trading-ai-backend-sync-controller --timeout=10m
                                kubectl -n "\$NS" rollout status daemonset/trading-ai-backend-celery-workers --timeout=10m

                                # Smoke test through the public ingress: process up (/live) and DB reachable (/ready).
                                for path in /live /ready; do
                                    curl -fsS --retry 5 --retry-delay 6 --retry-all-errors --max-time 10 "https://api.00x097.com\$path"
                                    echo
                                done
                            """
                        }
                        sh 'python3 "$CI_DIR/ci-gate.py" result rollout 0 "rollout complete, smoke test OK"'
                    } catch (err) {
                        echo "Rollout verification failed: ${err} - rolling back"
                        sh 'python3 "$CI_DIR/ci-gate.py" result rollout 1 "rollout / smoke test failed" || true'
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'git-gitea-jenkins-bot',
                                usernameVariable: 'GIT_USERNAME',
                                passwordVariable: 'GIT_TOKEN'
                            )
                        ]) {
                            withEnv(gitBotEnv()) {
                                // Reverting the bump commit puts the previous image tag back in
                                // cloud.config; ArgoCD (selfHeal) rolls the workloads back to it.
                                sh '''
                                    set -euo pipefail
                                    if [ ! -s cloud-config-bump-sha.txt ]; then
                                        echo "No bump commit recorded - nothing to revert"
                                        exit 0
                                    fi
                                    rm -rf .cloud-config-rollback
                                    git clone "https://${GIT_USERNAME}:${GIT_TOKEN}@git.00x097.com/tbs093a/cloud.config.git" .cloud-config-rollback
                                    cd .cloud-config-rollback
                                    git revert --no-edit "$(cat ../cloud-config-bump-sha.txt)"
                                    git push origin master
                                    cd .. && rm -rf .cloud-config-rollback
                                    python3 "$CI_DIR/ci-gate.py" result rollback 0 "cloud.config $(cut -c1-8 cloud-config-bump-sha.txt) reverted - ArgoCD rolls back to the previous image"
                                '''
                            }
                        }
                        error("Release of ${env.BUILD_SHA} rolled back - rollout/smoke test failed")
                    }
                }
            }
        }

        stage('RELEASE: Verify external egress') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                // The app is useless without its external APIs (exchanges, Yahoo Finance, OpenAI,
                // Telegram), and /live + /ready don't touch them: from 2026-09-23 to 2026-10-07 the
                // allow-vpn NetworkPolicy blocked all internet egress from backend-apps and every
                // deploy still went green. Checked from inside one pod of each workload - any HTTP
                // answer (even 429) proves the path is open. No rollback on failure: the image isn't
                // the cause (NetworkPolicy allow-internet-egress-trading-ai-backend in cloud.config is).
                // Least-privilege SA (cloud.config ci-rbac/jenkins-trading-ai-deployer.yml), not the
                // agent's cluster-admin kubeconfig: read rollout status + exec in backend-apps only.
                withCredentials([file(credentialsId: 'kubeconfig-trading-ai-deployer', variable: 'KUBECONFIG')]) {
                    sh '''
                        set -euo pipefail
                        failed=""
                        for w in deployment/trading-ai-backend-rest-api-controller \
                                 deployment/trading-ai-backend-sync-controller \
                                 daemonset/trading-ai-backend-celery-workers; do
                            if kubectl -n backend-apps exec -i "$w" -- python - <<'PY'
import sys
import urllib.error
import urllib.request

for url in ("https://api.binance.com/api/v3/ping", "https://query1.finance.yahoo.com/"):
    try:
        urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=10)
    except urllib.error.HTTPError:
        pass
    except Exception as e:
        print(f"{url}: {e}")
        sys.exit(1)
PY
                            then
                                echo "$w: internet egress OK"
                            else
                                failed="$failed ${w#*/}"
                            fi
                        done
                        if [ -n "$failed" ]; then
                            python3 "$CI_DIR/ci-gate.py" result egress 1 "no internet egress from:$failed - check NetworkPolicy allow-internet-egress-trading-ai-backend in cloud.config"
                        fi
                        python3 "$CI_DIR/ci-gate.py" result egress 0 "rest-api, sync, celery reach api.binance.com + Yahoo Finance"
                    '''
                }
            }
        }

        stage('RELEASE: DAST (OWASP ZAP baseline)') {
            when {
                expression { return isPostMerge() }
            }
            steps {
                sh '''
                    set -euo pipefail
                    mkdir -p zap-out
                    chmod 777 zap-out
                    # Baseline = passive spider + passive scan only, no active attack payloads -
                    # safe to run against the live production API. Do NOT swap this for
                    # zap-full-scan.py against api.00x097.com - that actively attacks the target,
                    # only ever run that against a non-production/staging environment.
                    # zap-baseline.py exits non-zero on any warning; the gate below decides instead.
                    docker run --rm -v "$WORKSPACE/zap-out:/zap/wrk:rw" zaproxy/zap-stable \
                        zap-baseline.py -t https://api.00x097.com \
                        -r zap-report.html -J zap-report.json || true
                    python3 "$CI_DIR/ci-gate.py" zap zap-out/zap-report.json --fail-on-risk 3
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap-out/**', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        // Declarative order: always -> success/unsuccessful -> cleanup. The comment is rendered in
        // always (currentResult is final by then), the CI scripts are removed only in cleanup.
        always {
            script {
                if (active()) {
                    updateResultsComment()
                }
            }
            archiveArtifacts artifacts: 'gate-results.json', allowEmptyArchive: true
        }
        success {
            script {
                if (active()) {
                    setStatus('success', isPullRequest() ? 'PRE-MERGE gate passed' : 'Delivered')
                }
            }
        }
        unsuccessful {
            script {
                if (active()) {
                    setStatus('failure', isPullRequest() ? 'PRE-MERGE gate failed' : 'Delivery failed')
                }
            }
        }
        // docker-builder-000 has one shared disk across every job here. Each run pulls
        // python:3.13-slim, semgrep/semgrep, aquasec/trivy, gitleaks and zaproxy/zap-stable on top of the
        // per-commit-tagged app image it builds (never :latest, never reused) - left unmanaged this
        // fills the disk in short order. On master the tag is in the registry by now, on PR builds
        // it was never pushed, so removing the local copy loses nothing. cleanup runs after every
        // other post condition; `|| true` throughout because a build that failed early may not
        // have reached later stages. (Only one post section is allowed in declarative pipelines.)
        cleanup {
            sh '''
                rm -f image.tar
                [ -n "${BUILD_SHA:-}" ] && docker rmi "registry.00x097.com/trading-ai-backend:${BUILD_SHA}" || true
                docker image prune -f || true
                docker builder prune -f --filter "until=24h" || true
                rm -f pr-comment-body.json
            '''
            sh "rm -rf '${ciDir()}' || true"
        }
    }
}
